FROM python:3.14-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Install Linux OPA for ACS enforcement in the container.
ARG OPA_VERSION=1.20.2
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && mkdir -p /app/tools \
    && curl -fSL --retry 3 "https://openpolicyagent.org/downloads/v${OPA_VERSION}/opa_linux_amd64_static" -o /app/tools/opa \
    && chmod 755 /app/tools/opa \
    && /app/tools/opa version \
    && rm -rf /var/lib/apt/lists/*
EXPOSE 8080
CMD ["uvicorn", "approval_api:app", "--host", "0.0.0.0", "--port", "8080"]
